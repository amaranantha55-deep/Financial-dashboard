# ==============================================================================
# FinBot Financial Assistant - Environment Variables Configuration
# ==============================================================================

# Anthropic Claude API Key (Required for real-time LLM tool-calling and reasoning)
# Stored securely on the server-side backend; NEVER exposed to the frontend browser.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Frontend API URL (Optional)
# Leave empty in production on Vercel or local dev with Vite proxy (defaults to relative '/api/chat').
# Uncomment if frontend is served on an external domain connecting to a separate backend host:
# VITE_API_URL=http://127.0.0.1:8000
